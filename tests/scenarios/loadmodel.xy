# the host's load model (host.c load_model) against the FM-1's Status page, as tools/measure_load.sh measured it on
# two cores (a new project: the tape at colour 24, FX I delay, FX II reverb): each row within 5 points. The keys
# are T3's, set to poly, held as the script holds them (G3 B3 D4 F4 A4 C5); the kit is T1's beat (four kicks, a
# snare on 2 and 4, eighth hats). The guard sees no load here (load 0): the model alone.
wait 300
load 0
# (measured when a new project's tape was at colour 24; a new project's is off now: set as measured)
mst color 24
# idle 21-22; the tape off 13
meter 1500
expect model_avg >16
expect model_avg <27
mst color 0
meter 1000
expect model_avg >7
expect model_avg <19
mst color 24
# weft (its first sound) x1 / x3 / x6: 43 / 49 / 57
knob 3 vmode poly
play 3 G3 on
wait 300
meter 1500
expect voices 1
expect model_avg >37
expect model_avg <49
play 3 B3 on
play 3 D4 on
wait 300
meter 1500
expect voices 3
expect model_avg >43
expect model_avg <55
play 3 F4 on
play 3 A4 on
play 3 C5 on
wait 300
meter 1500
expect voices 6
expect model_avg >51
expect model_avg <63
play 3 G3 off
play 3 B3 off
play 3 D4 off
play 3 F4 off
play 3 A4 off
play 3 C5 off
wait 4000
expect voices 0
# brocade (its first sound, nine saws) x1 / x3 / x4: 50 / 63 / 64
preset 3 gold_thread brocade
knob 3 vmode poly
play 3 G3 on
wait 300
meter 1500
expect voices 1
expect model_avg >44
expect model_avg <56
play 3 B3 on
play 3 D4 on
wait 300
meter 1500
expect voices 3
expect model_avg >57
expect model_avg <69
play 3 F4 on
wait 300
meter 1500
expect voices 4
expect model_avg >58
expect model_avg <70
play 3 G3 off
play 3 B3 off
play 3 D4 off
play 3 F4 off
wait 5000
expect voices 0
# cane bell x4: 55
preset 3 none cane
knob 3 e1 bell
knob 3 vmode poly
play 3 G3 on
play 3 B3 on
play 3 D4 on
play 3 F4 on
wait 300
meter 1500
expect voices 4
expect model_avg >49
expect model_avg <61
play 3 G3 off
play 3 B3 off
play 3 D4 off
play 3 F4 off
wait 5000
expect voices 0
# the kit playing: 25.5 (peak 43)
hits 1 1 1 x...x...x...x...
hits 1 1 2 ....x.......x...
hits 1 1 3 x.x.x.x.x.x.x.x.
tap PLAY
wait 1000
meter 4000
expect model_avg >20
expect model_avg <31
expect model_peak >37
expect model_peak <49
# the kit and weft x6: 64 (peak 82)
preset 3 none weft
knob 3 vmode poly
play 3 G3 on
play 3 B3 on
play 3 D4 on
play 3 F4 on
play 3 A4 on
play 3 C5 on
wait 300
meter 4000
expect model_avg >58
expect model_avg <70
expect model_peak >76
expect model_peak <88
play 3 F4 off
play 3 A4 off
play 3 C5 off
wait 3000
# the kit and weft x3, the tape off / colour 24 / all four at 64: 44 / 54 / 57.5
mst color 0
meter 4000
expect model_avg >38
expect model_avg <50
mst color 24
meter 4000
expect model_avg >48
expect model_avg <60
mst drive 64
mst color 64
mst wobble 64
mst noise 64
meter 4000
expect model_avg >52
expect model_avg <63

