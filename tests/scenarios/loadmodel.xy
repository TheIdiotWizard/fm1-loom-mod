# the host's load model (host.c load_model) against the FM-1's Status page, as tools/measure_load.sh measured it on
# two cores, 2026-10-18 (a new project: FX I delay, FX II reverb, the effects a block behind on the second core):
# each row within 6 points. The keys are T3's, set to poly, held as the script holds them (G3 B3 D4 F4 A4 C5); the
# kit is T1's beat (four kicks, a snare on 2 and 4, eighth hats). The guard sees no load here (load 0): the model alone.
wait 300
load 0
# idle 11
meter 1500
expect model_avg >5
expect model_avg <17
# weft (its first sound) x1 / x3 / x6: 20 / 29 / 36 (one voice wakes the effects: their job is the second core's)
knob 3 vmode poly
play 3 G3 on
wait 300
meter 1500
expect voices 1
expect model_avg >14
expect model_avg <26
play 3 B3 on
play 3 D4 on
wait 300
meter 1500
expect voices 3
expect model_avg >23
expect model_avg <35
play 3 F4 on
play 3 A4 on
play 3 C5 on
wait 300
meter 1500
expect voices 6
expect model_avg >30
expect model_avg <42
play 3 G3 off
play 3 B3 off
play 3 D4 off
play 3 F4 off
play 3 A4 off
play 3 C5 off
wait 4000
expect voices 0
# brocade (sequin, seven saws) x1 / x3 / x5: 21 / 33 / 44
preset 3 sequin brocade
knob 3 vmode poly
play 3 G3 on
wait 300
meter 1500
expect voices 1
expect model_avg >15
expect model_avg <27
play 3 B3 on
play 3 D4 on
wait 300
meter 1500
expect voices 3
expect model_avg >27
expect model_avg <39
play 3 F4 on
play 3 A4 on
wait 300
meter 1500
expect voices 5
expect model_avg >38
expect model_avg <50
play 3 G3 off
play 3 B3 off
play 3 D4 off
play 3 F4 off
play 3 A4 off
wait 5000
expect voices 0
# cane bell x4: 37
preset 3 none cane
knob 3 e1 bell
knob 3 vmode poly
play 3 G3 on
play 3 B3 on
play 3 D4 on
play 3 F4 on
wait 300
meter 1500
expect voices 4
expect model_avg >31
expect model_avg <43
play 3 G3 off
play 3 B3 off
play 3 D4 off
play 3 F4 off
wait 5000
expect voices 0
# the kit playing: 13 (peak 28)
hits 1 1 1 x...x...x...x...
hits 1 1 2 ....x.......x...
hits 1 1 3 x.x.x.x.x.x.x.x.
tap PLAY
wait 1000
meter 4000
expect model_avg >7
expect model_avg <19
expect model_peak >18
expect model_peak <38
# the kit and weft x6: 41.5 (peak 60)
preset 3 none weft
knob 3 vmode poly
play 3 G3 on
play 3 B3 on
play 3 D4 on
play 3 F4 on
play 3 A4 on
play 3 C5 on
wait 300
meter 4000
expect model_avg >35
expect model_avg <48
expect model_peak >50
expect model_peak <70
play 3 F4 off
play 3 A4 off
play 3 C5 off
wait 3000
# the kit and weft x3: 32.5 (peak 50)
meter 4000
expect model_avg >26
expect model_avg <39
expect model_peak >40
expect model_peak <60
play 3 G3 off
play 3 B3 off
play 3 D4 off
