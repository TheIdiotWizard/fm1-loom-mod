# a brain progression: track 3 follows, the brain's steps hold the chords its keys played, at scale 4
wait 200
spin ALGO 2
tap EDIT
tap SEL
turn SELECT 5
wait 40
shot brain_list.png
tap HOME
spin ALGO 6
expect trk 9
tap EDIT
wait 40
shot brain_page.png
spin K2 2
spin K3 1
wait 40
shot brain_key.png
turn SELECT 1
tapkey b1
wait 40
shot brain_routing.png
turn SELECT -1
key 7 down
key 11 down
wait 60
key 7 up
key 11 up
tap SEQ
expect page Steps
turn SELECT 1
tapkey b3
turn SELECT -1
tapkey w0
tapkey w8
wait 40
shot brain_steps.png
tap PLAY
wait 2000
tap EDIT
wait 40
shot brain_playing.png
tap PLAY
