# weave: T2's pattern 1 copied, pattern 2 written, then woven with the copy (SEL on Steps: WEAVE WITH COPIED)
wait 300
turn ALGO 1
expect trk 2
tap SEQ
expect page Steps
press SEQ
key 0 down
wait 40
key 0 up
release SEQ
tapkey w0
tapkey w4
tapkey w8
tapkey w12
tap SEL
wait 40
shot list_open.png
turn SELECT 3
wait 40
shot list_copy.png
tap SEL
wait 40
turn K1 1
wait 40
press SEQ
key 4 down
wait 40
key 4 up
release SEQ
tapkey w2
tapkey w3
tapkey w7
wait 40
shot p2.png
tap SEL
turn SELECT 5
wait 40
shot weave_bars.png
turn ALGO 2
wait 40
shot weave_rhythm.png
tap SEL
wait 60
shot woven.png
expect note 2 2 1 0
expect note 2 2 3 53
expect note 2 1 1 53
expect note 2 2 4 53
expect note 2 2 8 53
