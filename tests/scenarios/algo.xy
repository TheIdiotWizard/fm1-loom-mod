# ALGORITHM: the tracks that play on every page (T1-T8, COND, THROW), Mix's strips on Mix (T1-T8, FX I, FX II); off Mix
# an FX track gives way to the instrument picked last
wait 300
expect trk 1
turn ALGO -1
expect trk 10
turn ALGO -1
expect trk 9
turn ALGO 2
expect trk 1
tap GLO
turn ALGO -1
expect trk 12
turn ALGO -1
expect trk 11
turn ALGO -1
expect trk 8
turn ALGO 1
expect trk 11
tap SEQ
expect trk 8
tap GLO
turn ALGO 3
expect trk 1
