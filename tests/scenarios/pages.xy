# first boot: every page, a screenshot of each (the look), the footer and cards never too wide
wait 300
expect page Steps
wait 40
shot steps.png
tap SEQ
expect page Steps
turn SELECT 1
expect page Bar
wait 40
shot bar.png
tap HOME
expect page Arrange
wait 40
shot arrange.png
turn SELECT 1
expect page Song
wait 40
shot song.png
tap EDIT
expect page Engine
wait 40
shot engine.png
turn SELECT 1
expect page Play
wait 40
shot play.png
tap ENV
wait 40
shot envelope.png
turn SELECT 1
wait 40
shot envelope2.png
tap FX
wait 40
shot filter.png
turn SELECT 1
wait 40
shot sends.png
tap LFO
wait 40
shot lfo.png
turn SELECT 1
wait 40
shot lfo2.png
tap ARP
wait 40
shot players.png
turn SELECT 1
wait 40
shot players2.png
tap GLO
expect page Mix
wait 40
shot mix.png
turn SELECT 1
wait 40
shot master.png
turn SELECT 1
wait 40
shot master2.png
turn SELECT 1
wait 40
shot master3.png
turn SELECT 1
expect page Setup
wait 40
shot setup.png
turn SELECT 1
expect page Status
wait 40
shot status.png
# the help cards
tap SEQ
press SEQ
wait 1000
shot card_seq.png
release SEQ
expect page Steps
press REC
wait 1000
shot card_rec.png
release REC
expect playing 0
# a list and a question
tap SEL
wait 40
shot list_steps.png
tap HOME
expect page Steps
# the aux tracks' pages
tap EDIT
spin ALGO 8
wait 40
shot brain.png
spin ALGO 1
wait 40
shot punch.png
spin ALGO 1
wait 40
shot tape.png
spin ALGO 1
wait 40
shot fx1.png
turn SELECT 1
wait 40
shot fx1_2.png
spin ALGO -11
expect trk 1
