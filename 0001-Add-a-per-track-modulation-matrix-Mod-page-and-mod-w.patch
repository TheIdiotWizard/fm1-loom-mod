+    if (trk < 0 || trk >= NTRK || s < 0 || s >= MX_NSLOT)
+        return;
+    x = &pats.mod[trk].s[s];
+    if (field == 0)
+        v = clampi(v, 0, MXS_N - 1);
+    else if (field == 1)
+        v = clampi(v, 0, MXD_N - 1);
+    else
